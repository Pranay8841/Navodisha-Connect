meta {
  name: 1.2 Verify OTP (Auto-Saves JWT)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

body:json {
  {
    "phoneNumber": "{{testPhone}}",
    "otp": "123456"
  }
}

script:post-response {
  if (res.body.auth && res.body.auth.accessToken) {
    bru.setEnvVar("accessToken", res.body.auth.accessToken);
    bru.setEnvVar("refreshToken", res.body.auth.refreshToken);
  }
}
