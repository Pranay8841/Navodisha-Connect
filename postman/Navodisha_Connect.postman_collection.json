{
	"info": {
		"_postman_id": "navodisha-connect-api-v1",
		"name": "Navodisha Connect Backend API",
		"description": "Complete Postman collection for Navodisha Connect (JNV Alumni-Student Mentorship Platform). Includes auto-token capture scripts.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "testPhoneNumber",
			"value": "+917620149253",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. System & Health",
			"item": [
				{
					"name": "Ping Endpoint",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/ping",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"ping"
							]
						},
						"description": "Health and smoke-test ping returning PostgreSQL connection status."
					},
					"response": []
				},
				{
					"name": "Spring Boot Actuator Health",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"actuator",
								"health"
							]
						},
						"description": "Actuator operational health status."
					},
					"response": []
				}
			]
		},
		{
			"name": "1. Authentication (OTP & Registration)",
			"item": [
				{
					"name": "1.1 Send OTP",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phoneNumber\": \"{{testPhoneNumber}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/otp/send",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"otp",
								"send"
							]
						},
						"description": "Generates a 6-digit OTP and logs it to IntelliJ console (5-min expiry, 60s cooldown)."
					},
					"response": []
				},
				{
					"name": "1.2 Verify OTP (Auto-saves Token on Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.auth && jsonData.auth.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.auth.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.auth.refreshToken);",
									"    console.log('✅ Access Token automatically saved to Postman collection variable: ' + jsonData.auth.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phoneNumber\": \"{{testPhoneNumber}}\",\n    \"otp\": \"PASTE_OTP_FROM_CONSOLE_HERE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/otp/verify",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"otp",
								"verify"
							]
						},
						"description": "Verifies submitted OTP. If user exists, returns JWT tokens and auto-saves them to Postman variable."
					},
					"response": []
				},
				{
					"name": "1.3 Register - Student (Instant Active)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"    console.log('✅ Access Token saved from student registration: ' + jsonData.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phoneNumber\": \"+918888877777\",\n    \"fullName\": \"Alok Student\",\n    \"role\": \"STUDENT\",\n    \"jnvName\": \"JNV Cuttack\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						},
						"description": "Onboards a Student. Automatically receives status ACTIVE and issues JWT tokens."
					},
					"response": []
				},
				{
					"name": "1.4 Register - Alumnus (Pending Verification)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phoneNumber\": \"+919999988888\",\n    \"fullName\": \"Senior Navodayan\",\n    \"role\": \"ALUMNUS\",\n    \"jnvName\": \"JNV Nagpur\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						},
						"description": "Onboards an Alumnus. Status is set to PENDING_VERIFICATION (requires Platform Admin approval)."
					},
					"response": []
				},
				{
					"name": "1.5 Register - JNV Admin (Pending Verification)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phoneNumber\": \"+919111122222\",\n    \"fullName\": \"JNV Principal Sir\",\n    \"role\": \"JNV_ADMIN\",\n    \"jnvName\": \"JNV Pune\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						},
						"description": "Onboards a JNV School Admin. Status is set to PENDING_VERIFICATION."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Users (Protected Endpoints)",
			"item": [
				{
					"name": "2.1 Get Current User Profile (Me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								"me"
							]
						},
						"description": "Protected API requiring Bearer accessToken. Returns the calling user's authenticated profile."
					},
					"response": []
				},
				{
					"name": "2.2 Get Me - Missing Token (Verify 401)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								"me"
							]
						},
						"description": "Expects HTTP 401 Unauthorized with clean JSON error envelope."
					},
					"response": []
				}
			]
		}
	]
}
